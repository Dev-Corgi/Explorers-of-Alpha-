}

coro TALK_ATTENDANT {
    Branch($ATTENDANT1_KIND, 2, @label_0);
    message_Talk({
        english="[M:D0]Did you need something?",
    });
    JumpCommon(CORO_END_TALK);
    @label_0;
    JumpCommon(CORO_TALK_PARTNER_MESSAGE);
}

coro TALK_PARTNER_MESSAGE {
    SwitchScenario($SCENARIO_SELECT);
    CaseScenario(2, 51, @label_1);
    CaseScenario(2, 52, @label_1);
    CaseScenario(2, 53, @label_2);
    Jump(@label_3);
    @label_1;
    lives(ACTOR_TALK_MAIN);
    SetAnimation(2);
    lives(ACTOR_TALK_SUB);
    SetAnimation(2);
    lives(ACTOR_TALK_MAIN);
    Turn2DirectionLives(4, 10, ACTOR_TALK_SUB);
    lives(ACTOR_TALK_SUB);
    Turn2DirectionLives(4, 10, ACTOR_TALK_MAIN);
    WaitExecuteLives(ACTOR_TALK_MAIN);
    WaitExecuteLives(ACTOR_TALK_SUB);
    lives(ACTOR_TALK_MAIN);
    ExecuteCommon(CORO_LIVES_REPLY_NORMAL, 0);
    lives(ACTOR_TALK_SUB);
    ExecuteCommon(CORO_LIVES_REPLY_NORMAL, 0);
    supervision_ExecuteExport('PARTNER2');
    JumpCommon(CORO_END_TALK);
    @label_2;
    JumpCommon(CORO_END_TALK);
    @label_3;
    Switch($EXECUTE_SPECIAL_EPISODE_TYPE);
    Case(0, @label_4);
    Case(1, @label_4);
    Case(2, @label_4);
    Case(4, @label_4);
    Case(3, @label_4);
    Jump(@label_5);
    @label_4;
    supervision_Suspend(-2);
    End();
    @label_5;
    Switch($GROUND_ENTER);
    Case(23, @label_1);
    Case(24, @label_1);
    Case(25, @label_1);
    Case(26, @label_1);
    Case(38, @label_1);
    Case(45, @label_1);
    Case(46, @label_1);
    Case(47, @label_1);
    Case(50, @label_1);
    Case(51, @label_1);
    Case(52, @label_1);
    Case(55, @label_1);
    Case(59, @label_1);
    Case(67, @label_1);
    Case(74, @label_1);
    Case(97, @label_1);
    Case(228, @label_1);
    Case(456, @label_6);
    Jump(@label_7);
    @label_6;
    JumpCommon(CORO_END_TALK);
    @label_7;
    Switch($GROUND_ENTER);
    Case(27, @label_8);
    Case(30, @label_9);
    Case(35, @label_10);
    Case(48, @label_11);
    Case(56, @label_12);
    Case(60, @label_13);
    Case(68, @label_14);
    Case(90, @label_15);
    Case(98, @label_16);
    Case(102, @label_17);
    Case(177, @label_15);
    Case(176, @label_15);
    Case(223, @label_15);
    Case(77, @label_15);
    Case(78, @label_15);
    Case(79, @label_15);
    Case(157, @label_15);
    Case(158, @label_15);
    Case(159, @label_15);
    Case(160, @label_15);
    Case(161, @label_15);
    Case(162, @label_15);
    Case(163, @label_15);
    Case(164, @label_15);
    Case(165, @label_15);
    Case(166, @label_15);
    Jump(@label_18);
    @label_8;
    BranchScenarioNowAfter($SCENARIO_MAIN, 29, 5, @label_4);
    Branch($SCENARIO_MAIN, 11, @label_19);
    Jump(@label_1);
    @label_19;
    lives(ACTOR_TALK_MAIN);
    SetAnimation(2);
    lives(ACTOR_TALK_SUB);
    SetAnimation(2);
    lives(ACTOR_TALK_MAIN);
    Turn2DirectionLives(4, 10, ACTOR_TALK_SUB);
    lives(ACTOR_TALK_SUB);
    Turn2DirectionLives(4, 10, ACTOR_TALK_MAIN);
    WaitExecuteLives(ACTOR_TALK_MAIN);
    WaitExecuteLives(ACTOR_TALK_SUB);
    lives(ACTOR_TALK_MAIN);
    ExecuteCommon(CORO_LIVES_REPLY_NORMAL, 0);
    lives(ACTOR_TALK_SUB);
    ExecuteCommon(CORO_LIVES_REPLY_NORMAL, 0);
    supervision_ExecuteExport('PARTNER');
    JumpCommon(CORO_END_TALK);
    Jump(@label_20);
    @label_9;
    BranchScenarioNowAfter($SCENARIO_MAIN, 29, 5, @label_4);
    Branch($SCENARIO_MAIN, 13, @label_19);
    Jump(@label_1);
    Jump(@label_20);
    @label_10;
    BranchScenarioNowAfter($SCENARIO_MAIN, 29, 5, @label_4);
    Branch($SCENARIO_MAIN, 15, @label_19);
    Jump(@label_1);
    Jump(@label_20);
    @label_11;
    BranchScenarioNowAfter($SCENARIO_MAIN, 29, 5, @label_4);
    Branch($SCENARIO_MAIN, 19, @label_19);
    Jump(@label_1);
    Jump(@label_20);
    @label_12;
    BranchScenarioNowAfter($SCENARIO_MAIN, 29, 5, @label_4);
    Branch($SCENARIO_MAIN, 24, @label_19);
    Jump(@label_1);
    Jump(@label_20);
    @label_13;
    Branch($SCENARIO_MAIN, 25, @label_19);
    Branch($SCENARIO_MAIN, 26, @label_19);
    Jump(@label_1);
    Jump(@label_20);
    @label_14;
    Branch($SCENARIO_MAIN, 26, @label_19);
    Jump(@label_1);
    Jump(@label_20);
    @label_15;
    Jump(@label_4);
    @label_16;
    BranchScenarioNowAfter($SCENARIO_MAIN, 29, 92, @label_4);
    Jump(@label_1);
    Jump(@label_20);
    @label_17;
