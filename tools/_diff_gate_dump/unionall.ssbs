coro EVENT_S31_01 {
    CallCommon(CORO_SUBSCREEN_INIT);
    supervision_ExecuteActingSub(LEVEL_P01P01A, 'S31A0101', 0);
    message_Mail('Would you like to skip this cutscene?');
    message_SwitchMenu(0, 1);
    CaseMenu({
        english="Yes",
    }, @label_768);
    CaseMenu({
        english="No",
    }, @label_769);
    Jump(@label_770);
    @label_768;
    message_Close();
    back2_SetMode(0);
    screen_FadeOut(1, 30);
    worldmap_SetMode(4);
    back2_SetMode(3);
    WaitSubScreen();
    worldmap_SetCamera(264);
    worldmap_SetArrow(264);
    worldmap_BlinkMark(264);
    flag_CalcBit($SPECIAL_EPISODE_OPEN_OLD, 7, 1);
    me_Play(6);
    message_Mail({
        english="""
            [CN]You can now go to
            [CN]the [CS:P]Shaymin Village[CR]!
        """,
    });
    WaitMe(6);
    message_Close();
    screen2_FadeOut(0, 15);
    main_EnterGround(LEVEL_P01P04A, 30);
    Hold();
    @label_769;
    message_Close();
    supervision_ExecuteActingSub(LEVEL_P01P04A, 'S31A0102', 0);
    supervision_ExecuteActingSub(LEVEL_V37P01A, 'S31A0103', 0);
    supervision_ExecuteActingSub(LEVEL_P01P04A, 'S31A0104', 0);
    @label_771;
    CallCommon(CORO_EVENT_END_MAPIN);
    main_SetGround(LEVEL_P01P04A);
    supervision_ExecuteStationCommon(LEVEL_P01P04A, 1);
    End();
    @label_770;
    Jump(@label_771);
}

