coro MOVE_DEBUG_CAMERA {
    camera_SetMyself();
    ProcessSpecial(18, 0, 0);
    Unlock(4);
    camera_SetDefault();
    Destroy();
}

coro MESSAGE_CLOSE_WAIT_FUNC {
    message_Close();
    Wait(10);
    Return();
}

coro EVENT_END_MAPIN {
    debug_Print('EVENT_END_MAPIN');
    camera_MoveDefault(1.5);
    WaitMoveCamera();
    Switch($EXECUTE_SPECIAL_EPISODE_TYPE);
    Case(0, @label_1599);
    Case(1, @label_1600);
    Case(2, @label_1601);
    Case(4, @label_1602);
    Case(3, @label_1603);
    Jump(@label_1604);
    @label_1599;
    supervision_StationCommon(21);
    lives(ACTOR_PLAYER_BIPPA);
    SetFunctionAttribute(2);
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    @label_1605;
    supervision_Suspend(-2);
    supervision_RemoveActing(-2);
    back2_SetMode(-1);
    WaitSubScreen();
    Return();
    @label_1600;
    supervision_StationCommon(31);
    lives(ACTOR_PLAYER_PUPURIN);
    SetFunctionAttribute(2);
    WaitExecuteLives(ACTOR_PLAYER_PUPURIN);
    Jump(@label_1605);
    @label_1601;
    supervision_StationCommon(41);
    lives(ACTOR_PLAYER_KIMAWARI);
    SetFunctionAttribute(2);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    Jump(@label_1605);
    @label_1602;
    supervision_StationCommon(51);
    lives(ACTOR_PLAYER_FUTURE);
    SetFunctionAttribute(2);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    Jump(@label_1605);
    @label_1603;
    supervision_StationCommon(61);
    lives(ACTOR_PLAYER_CHARMS);
    SetFunctionAttribute(2);
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    Jump(@label_1605);
    @label_1604;
    supervision_StationCommon(1);
    lives(ACTOR_PLAYER);
    SetFunctionAttribute(2);
    lives(ACTOR_ATTENDANT1);
    SetFunctionAttribute(2);
    WaitExecuteLives(ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Jump(@label_1605);
}

