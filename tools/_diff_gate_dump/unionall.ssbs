    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 241, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 242, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 250, 0);
