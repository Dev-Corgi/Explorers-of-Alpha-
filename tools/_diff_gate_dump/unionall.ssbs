coro TALK_UNIT {
    lives(ACTOR_TALK_MAIN);
    ExecuteCommon(CORO_LIVES_REPLY_NORMAL, 0);
    lives(ACTOR_TALK_SUB);
    ExecuteCommon(CORO_LIVES_REPLY_NORMAL, 0);
    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
    message_SpecialTalk(0);
    JumpCommon(CORO_END_TALK);
}

