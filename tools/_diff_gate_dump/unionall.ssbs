coro HANYOU_SAVE_FUNC {
    BranchBit($SCENARIO_MAIN_BIT_FLAG, 7, @label_33);
    message_Mail({
        english="[CN]Would you like to save your adventure?",
    });
    message_SwitchMenu(0, 2);
    CaseMenu({
        english="Yes",
    }, @label_34);
    CaseMenu({
        english="No",
    }, @label_35);
    @label_33;
    message_Mail({
        english="[CN]Would you like to save your adventure?",
    });
    message_SwitchMenu(0, 3);
    CaseMenu({
        english="Save and Continue",
    }, @label_34);
    CaseMenu({
        english="Save and Return to Top Menu",
    }, @label_36);
    CaseMenu({
        english="Don't Save",
    }, @label_35);
    @label_34;
    message_Close();
    BranchBit($SCENARIO_MAIN_BIT_FLAG, 7, @label_37);
    debug_Print('COMPULSORY_SAVE');
    flag_Set($GROUND_PLACE, 307);
    @label_37;
    flag_CalcBit($SCENARIO_MAIN_BIT_FLAG, 6, 1);
    message_Menu(MENU_SAVE_MENU);
    flag_CalcBit($SCENARIO_MAIN_BIT_FLAG, 6, 0);
    flag_CalcBit($SCENARIO_MAIN_BIT_FLAG, 7, 0);
    Return();
    @label_36;
    message_Close();
    flag_CalcBit($SCENARIO_MAIN_BIT_FLAG, 6, 1);
    message_Menu(MENU_SAVE_MENU);
    bgm_FadeOut(60);
    screen2_FadeOut(0, 30);
    screen_FadeOut(1, 30);
    ProcessSpecial(PROCESS_SPECIAL_JUMP_TO_TITLE_SCREEN, 0, 0);
    Return();
    @label_35;
    message_Close();
    flag_CalcBit($SCENARIO_MAIN_BIT_FLAG, 7, 0);
    Return();
}

