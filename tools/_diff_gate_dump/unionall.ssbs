coro EVENT_N03_06_07 {
    CallCommon(CORO_DEBUG_FLAG_SETTING_PUPURIN);
    CallCommon(CORO_SUBSCREEN_INIT);
    BranchScenarioNow($SCENARIO_SIDE, 42, 4, @label_783);
    supervision_ExecuteActingSub(LEVEL_D44P31A, 'N03A0601', 0);
    @label_783;
    message_Mail('Would you like to skip this cutscene?');
    message_SwitchMenu(0, 1);
    CaseMenu({
        english="Yes",
    }, @label_784);
    CaseMenu({
        english="No",
    }, @label_785);
    Jump(@label_786);
    @label_784;
    message_Close();
    supervision_ExecuteActingSub(LEVEL_P17P02A, 'N03A0702', 0);
    supervision_ExecuteActingSub(LEVEL_P19P02A, 'N03A0703', 0);
    supervision_ExecuteActingSub(LEVEL_P20P02A, 'N03A0704', 0);
    supervision_ExecuteActingSub(LEVEL_P20P03A, 'N03A0705', 0);
    supervision_ExecuteActingSub(LEVEL_P21P02A, 'N03A0706', 0);
    supervision_ExecuteActingSub(LEVEL_P17P02A, 'N03A0707', 0);
    ProcessSpecial(PROCESS_SPECIAL_SET_TEAM_SETUP_HERO_ONLY, 0, 0);
    CallCommon(CORO_EVENT_END_MAPIN);
    main_SetGround(LEVEL_P17P02A);
    supervision_ExecuteStationCommon(LEVEL_P17P02A, 1);
    End();
    @label_785;
    message_Close();
    supervision_ExecuteActingSub(LEVEL_P20P01A, 'N03A0701', 0);
    Jump(@label_784);
    @label_786;
    Jump(@label_784);
}

