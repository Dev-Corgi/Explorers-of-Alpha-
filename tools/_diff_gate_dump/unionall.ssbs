coro EVENT_M14_08_09 {
    CallCommon(CORO_SUBSCREEN_INIT);
    message_Mail('Would you like to skip this cutscene?');
    message_SwitchMenu(0, 1);
    CaseMenu({
        english="Yes",
    }, @label_724);
    CaseMenu({
        english="No",
    }, @label_725);
    Return();
    @label_724;
    message_Close();
    message_Mail('Now explore [CS:P]Crystal Cave[CR]!');
    message_Close();
    flag_SetScenario($SCENARIO_MAIN, 15, 4);
    flag_SetDungeonMode(24, 1);
