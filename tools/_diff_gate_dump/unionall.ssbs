coro EVENT_FORMATION {
    screen_FadeOut(1, 30);
    BranchScenarioAfter($SCENARIO_MAIN, 30, 2, @label_38);
    flag_SetScenario($SCENARIO_MAIN, 30, 2);
    flag_Set($ATTENDANT1_KIND, 0);
    flag_Set($ATTENDANT2_KIND, 0);
    @label_38;
    flag_CalcVariable($GROUND_GETOUT, 0, $GROUND_ENTER);
    flag_Set($GROUND_ENTER_LINK, 0);
    flag_Set($GROUND_START_MODE, 3);
    supervision_ExecuteCommon(CORO_EVENT_DIVIDE);
    Hold();
}

