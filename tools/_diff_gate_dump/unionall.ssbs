coro MOVE_WORLD_MAP {
    debug_Print('MOVE_WORLD_MAP');
    screen_FadeOutAll(1, 0);
    WaitSubScreen();
    BranchBit($SCENARIO_TALK_BIT_FLAG, 229, @label_1457);
    worldmap_SetMode(1);
    back2_SetMode(3);
    back_SetGround(LEVEL_S04P01A);
    WaitSubScreen();
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
    worldmap_SetCamera(1000);
    WaitSubScreen();
    Wait(30);
    Jump(@label_1458);
    @label_1457;
    worldmap_SetMode(0);
    back2_SetMode(3);
    back_SetGround(LEVEL_S04P01A);
    WaitSubScreen();
    bgm_PlayFadeIn(BGM_IN_THE_FUTURE, 0, 256);
    worldmap_SetCamera(1000);
    WaitSubScreen();
    Wait(30);
    @label_1458;
    worldmap_MoveCamera(1001);
    WaitSubScreen();
    worldmap_SetMessagePlace(1001);
    Wait(60);
    back2_SetMode(1);
    WaitSubScreen();
    bgm_FadeOut(60);
    ProcessSpecial(24, 0, 0);
    Hold();
}

