    BranchScenarioNowAfter($SCENARIO_SIDE, 42, 1, @label_780);
    BranchScenarioNow($SCENARIO_SIDE, 41, 4, @label_781);
    BranchScenarioNow($SCENARIO_SIDE, 41, 5, @label_782);
