coro EVENT_DIVIDE {
    debug_Print('EVENT_DIVIDE');
    BranchVariation(1, @label_39);
    SwitchScenario($SCENARIO_SELECT);
    CaseScenario(2, 51, @label_40);
    CaseScenario(2, 52, @label_41);
    CaseScenario(2, 53, @label_42);
    CaseScenario(2, 54, @label_43);
    Jump(@label_44);
    @label_40;
    debug_Print('EVENT_DIVIDE_RESCUE_USER');
    SwitchScenarioLevel($SCENARIO_SELECT);
    Case(0, @label_45);
    Jump(@label_46);
    @label_45;
    flag_SetScenario($SCENARIO_SELECT, 51, 1);
    flag_ResetDungeonResult();
    flag_Set($PLAYER_KIND, 0);
    flag_Set($ATTENDANT1_KIND, 2);
    flag_Set($ATTENDANT2_KIND, 0);
    @label_47;
    main_SetGround(LEVEL_S01P02A);
    flag_Set($GROUND_PLACE, 185);
    supervision_ExecuteEnter(-1);
    Hold();
    @label_46;
    Jump(@label_47);
    Jump(@label_48);
    @label_41;
    debug_Print('EVENT_DIVIDE_RESCUE_WAIT');
    SwitchScenarioLevel($SCENARIO_SELECT);
    Case(0, @label_49);
    Jump(@label_50);
    @label_49;
    flag_SetScenario($SCENARIO_SELECT, 52, 1);
    flag_ResetDungeonResult();
    flag_Set($PLAYER_KIND, 0);
    flag_Set($ATTENDANT1_KIND, 2);
    flag_Set($ATTENDANT2_KIND, 0);
    @label_51;
    main_SetGround(LEVEL_S01P03A);
    flag_Set($GROUND_PLACE, 185);
    supervision_ExecuteEnter(-1);
    Hold();
    @label_50;
    Jump(@label_51);
    Jump(@label_48);
    @label_42;
    debug_Print('EVENT_DIVIDE_DEBUG');
    SwitchScenarioLevel($SCENARIO_MAIN);
    Case(0, @label_52);
    Jump(@label_53);
    @label_52;
    flag_SetScenario($SCENARIO_MAIN, 53, 1);
    CallCommon(CORO_EVENT_DIVIDE_INIT_FUNC);
    main_SetGround(LEVEL_T00P01);
    @label_54;
    flag_SetScenario($SCENARIO_SELECT, 53, 1);
    @label_73;
    supervision_ExecuteEnter(-1);
    Hold();
    @label_53;
    Jump(@label_54);
    Jump(@label_48);
    @label_43;
    flag_Clear($SCENARIO_MAIN_BIT_FLAG);
    flag_SetScenario($SCENARIO_SIDE, 0, 0);
    Wait(1);
    flag_SetScenario($SCENARIO_SELECT, 0, 0);
    Switch($EXECUTE_SPECIAL_EPISODE_TYPE);
    Case(0, @label_55);
    Case(1, @label_56);
    Case(2, @label_57);
    Case(4, @label_58);
    Case(3, @label_59);
    @label_55;
    flag_SetScenario($SCENARIO_SIDE, 40, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 126, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 127, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 128, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 129, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 130, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 131, 0);
    flag_CalcBit($SIDE01_BOSS2ND, 0, 0);
    @label_60;
    debug_Print('SPECIAL_EPOSDE');
    JumpCommon(CORO_EVENT_DIVIDE_SPECIAL_EPISODE);
    @label_56;
    debug_Print('INIT_PUPURIN');
    flag_SetScenario($SCENARIO_SIDE, 41, 0);
    ProcessSpecial(PROCESS_SPECIAL_SET_TEAM_SETUP_HERO_ONLY, 0, 0);
    flag_CalcBit($SIDE02_TALK, 1, 0);
    flag_CalcBit($SIDE02_TALK, 2, 0);
    flag_CalcBit($SIDE02_TALK, 0, 0);
    flag_SetDungeonMode(128, 0);
    flag_SetDungeonMode(176, 0);
    Jump(@label_60);
    @label_57;
    flag_SetScenario($SCENARIO_SIDE, 43, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 132, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 133, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 134, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 135, 0);
    flag_CalcBit($SCENARIO_TALK_BIT_FLAG, 136, 0);
